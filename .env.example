# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL of this SmartBilling deployment. Needed for payment return links.
APP_URL=""

# Local development starts the API server on port 3001 and proxies /api through Vite.
# Docker Compose publishes host port 1707 to container port 3000 by default.
# Change this if port 1707 is already in use.
BILLING_PORT=1707

# MikroTik RouterOS Connection
MIKROTIK_HOST=""
MIKROTIK_PORT=8728
MIKROTIK_USER=""
MIKROTIK_PASS=""
MIKROTIK_API_TYPE="api"
MIKROTIK_TIMEOUT_SEC=10

# Optional fixed admin credentials. Leave BOTH empty to register the first admin
# once from the login page; credentials are otherwise managed only in this file.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Optional 32-byte base64 key. If empty, a random key is generated and persisted
# in data/router-secrets.key. Keep that file with the SQLite database backups.
APP_ENCRYPTION_KEY=""

# Online checkout currently supports Midtrans Snap.
PAYMENT_GATEWAY="midtrans"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# WhatsApp provider selection: openwa or fonnte. Leave empty to select in admin.
WA_PROVIDER=""
# OpenWA must be installed/hosted separately from SmartBilling.
OPENWA_BASE_URL=""
OPENWA_API_KEY=""
OPENWA_SESSION_ID="billing-isp"
# Fonnte is an external REST API service; obtain the token from your Fonnte account.
FONNTE_API_URL="https://api.fonnte.com/send"
FONNTE_TOKEN=""
WA_SENDER_NUMBER=""
