# Optional: Gemini API key for AI features, when enabled.
GEMINI_API_KEY=""

# Public host port for the web app. Container port is always 1707.
BILLING_PORT=1707
TZ="Asia/Jakarta"

# Public Portal origin used for customer-facing invoice and payment return links.
APP_URL=""

# Public SmartBilling API webhook endpoint; keep this separate from APP_URL when
# the Portal and SmartBilling API use different domains.
PAYMENT_WEBHOOK_URL=""

# MikroTik RouterOS Connection
MIKROTIK_HOST=""
MIKROTIK_PORT=8728
MIKROTIK_USER=""
MIKROTIK_PASS=""
MIKROTIK_API_TYPE="api"
MIKROTIK_TIMEOUT_SEC=10

# Optional fixed admin credentials. Leave BOTH empty to register the first admin
# once from the login page; credentials are otherwise managed only in this file.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Optional 32-byte base64 key. If empty, a random key is generated and persisted
# in data/router-secrets.key. Keep that file with the SQLite database backups.
APP_ENCRYPTION_KEY=""

# Legacy fallback for an existing Midtrans setup. Configure the active gateway
# and provider credentials in Admin > Pembayaran; only one gateway is active.
PAYMENT_GATEWAY="midtrans"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# Optional Telegram bot fallback. Settings entered in the dashboard take priority.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp provider selection: openwa or fonnte. Leave empty to select in admin.
WA_PROVIDER=""
# OpenWA must be installed/hosted separately from SmartBilling.
OPENWA_BASE_URL=""
OPENWA_API_KEY=""
OPENWA_SESSION_ID="billing-isp"
# Fonnte is an external REST API service; obtain the token from your Fonnte account.
FONNTE_API_URL="https://api.fonnte.com/send"
FONNTE_TOKEN=""
WA_SENDER_NUMBER=""
